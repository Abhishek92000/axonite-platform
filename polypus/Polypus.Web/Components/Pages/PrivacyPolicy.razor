@page "/privacy-policy"
@*
    PrivacyPolicy.razor  -  route /privacy-policy
    ------------------------------------------------------------------------
    Privacy Policy. Structure comes from Components/Shared/LegalDocument.razor;
    only the content lives here.

    This is a realistic starting draft, not legal advice. Have counsel review
    and complete the bracketed placeholders before publishing.

    Linked from: the footer meta row and the footer "Legal" column, and from
    the consent checkbox on the contact form.
*@

<PageTitle>Polypus Privacy Policy</PageTitle>

<HeadContent>
    <meta name="description"
          content="How Axonite collects, uses, stores and deletes personal data in connection with the Polypus website and the Polypus document processing service." />
</HeadContent>

<PageHero Section="Privacy Policy"
          Eyebrow="Legal"
          Title="Privacy Policy"
          Lead="How Axonite handles personal data in the Polypus marketing site and in the Polypus document processing service." />

<section class="section section--flush">
    <div class="container">
        <LegalDocument Updated="12 June 2025" Intro="@Intro" Sections="_sections" />
    </div>
</section>

@code {
    private const string Intro =
        "This policy covers two different things: the personal data we collect when you visit this " +
        "website or contact us, and the personal data contained inside the business documents our " +
        "customers process through Polypus. Where you are a customer, the Data Processing Addendum " +
        "governs the second category and takes precedence over this policy.";

    private static readonly IReadOnlyList<LegalSection> _sections =
    [
        new LegalSection("who-we-are", "Who we are",
        [
            $"{CompanyProfile.LegalName} builds and operates Polypus. For the purposes of the EU General Data Protection Regulation we act as a data controller for website visitors and prospective customers, and as a data processor for the contents of customer documents."
        ])
        {
            Note = $"Registered office: Level 7, Amar Tech Park, Balewadi, Pune 411045, India. {CompanyProfile.RegistrationNote}. Data protection contact: privacy@axonite.io"
        },

        new LegalSection("what-we-collect", "What we collect",
        [
            "When you visit this site we collect standard server log data: IP address, user agent, request path and timestamp. When you submit the contact form we collect the details you type into it."
        ])
        {
            Bullets =
            [
                "Contact form: name, work email, company, plan of interest, monthly document volume, SAP landscape, your message and your consent flag",
                "Account data for customers: administrator names, email addresses, roles and audit records of changes they make",
                "Document content: whatever a customer submits to the service, which may contain personal data belonging to their employees, suppliers or contacts",
                "Usage data: feature usage counts and error events, used to operate and improve the service",
                "Cookie data: see the Cookie Policy for the small number of strictly necessary cookies we set"
            ]
        },

        new LegalSection("why-we-use-it", "Why we use it and our lawful basis",
        [
            "We only process personal data where we have a lawful basis to do so."
        ])
        {
            Bullets =
            [
                "To answer your enquiry and manage the sales conversation - legitimate interests, and consent where you have ticked the contact box",
                "To provide, secure and support the Polypus service under a customer contract - performance of a contract",
                "To meet tax, accounting and audit obligations - legal obligation",
                "To investigate security incidents and prevent abuse - legitimate interests",
                "To send release notes or product updates - consent, withdrawable at any time"
            ]
        },

        new LegalSection("customer-documents", "Personal data inside customer documents",
        [
            "Documents processed through Polypus belong to the customer. Axonite processes them only on the customer's documented instructions, as set out in the order form and the Data Processing Addendum.",
            "Customer documents are never used to train models shared with other tenants. Tuning is applied within the tenant, and on Enterprise or on-premise deployments model artefacts stay inside the customer environment.",
            "Retention of document content is configured per tenant. The default is 24 months from processing, after which extracted data, source files and derived artefacts are deleted on a rolling basis."
        ]),

        new LegalSection("sharing", "Who we share data with",
        [
            "We do not sell personal data. We share it only with sub-processors who help us run the service, and only under written contracts that mirror our own obligations."
        ])
        {
            Bullets =
            [
                "Cloud infrastructure providers in the region you selected (EU, India or US)",
                "Email delivery for transactional notifications",
                "Support ticketing and incident management tooling",
                "Professional advisers and auditors where legally required",
                "Competent authorities where we are legally compelled to respond"
            ],
            Note = "A current sub-processor list is available on request from privacy@axonite.io, and customers are notified at least 30 days before a new sub-processor is added."
        },

        new LegalSection("transfers", "International transfers",
        [
            "Tenants are provisioned in the region chosen at sign-up and data residency is fixed for the life of the tenant. Where support staff outside your region need to view data to resolve a ticket, access is granted on a time-limited, logged basis under standard contractual clauses.",
            "Contact form submissions from the EU are stored in the EU region. Where a submission must be visible to a sales team outside the EU, it is transferred under standard contractual clauses or an approved adequacy mechanism."
        ]),

        new LegalSection("retention", "How long we keep it",
        [
            "We keep personal data only as long as we need it for the purpose it was collected, or as long as a legal obligation requires."
        ])
        {
            Bullets =
            [
                "Marketing enquiries that do not become customers: 24 months from the last contact",
                "Customer contract and billing records: 8 years from the end of the financial year",
                "Server logs: 90 days, unless retained longer for an active security investigation",
                "Support tickets: 36 months from resolution",
                "Document content: 24 months by default, configurable per tenant"
            ]
        },

        new LegalSection("your-rights", "Your rights",
        [
            "You can ask us to confirm what personal data we hold about you, correct it, delete it, restrict how we use it, or provide it in a portable format. Where we rely on consent, you can withdraw it at any time without affecting processing that already happened.",
            "Write to privacy@axonite.io. We respond within 30 days. If you are in the EU or UK you also have the right to complain to your national supervisory authority."
        ]),

        new LegalSection("security", "Security",
        [
            "Polypus is operated under controls aligned to SOC 2 Type II and ISO 27001. Data is encrypted in transit and at rest, tenants are isolated at the data layer, and access to production data requires a logged, approved break-glass procedure.",
            "We run annual third-party penetration tests and share the summary report under NDA. Customers can request our security questionnaire response, business continuity plan and sub-processor list."
        ]),

        new LegalSection("changes", "Changes to this policy",
        [
            "We date every version of this policy. Material changes are announced to customers by email at least 30 days before they take effect. Continued use of the service after that date constitutes acceptance."
        ])
    ];
}
