@page "/careers"
@*
    Careers.razor  -  route /careers
    ------------------------------------------------------------------------
    Open roles. Deliberately simple: the roles live in the OpenRoles list below
    because they change more often than the rest of the site's content.

    Roles are sample content for the template - replace with real vacancies, or
    point the page at an ATS (Greenhouse, Lever, Workable) by swapping the apply
    links for the ATS URL.

    Linked from the footer "Company" column.
*@

<PageTitle>Careers at Axonite - build Polypus</PageTitle>

<HeadContent>
    <meta name="description"
          content="Open roles at Axonite, the company behind Polypus: integration engineering, delivery, applied document AI and support in Pune, Amsterdam and Dubai." />
</HeadContent>

<PageHero Section="Careers"
          Eyebrow="Join us"
          Title="Build the thing that replaces the re-keying"
          Lead="We are a product company, not a body shop. Engineers here own pipelines end to end and talk directly to the finance teams who run them."
          Pills="_pills" />

<section class="section section--flush">
    <div class="container container--narrow">
        <SectionHeading Eyebrow="Open roles"
                       Title="Six positions across three locations" />

        <div class="stack mt-6">
            @foreach (var role in OpenRoles)
            {
                <article class="feature-detail">
                    <div class="feature-detail__head">
                        <span class="feature-detail__icon"><AppIcon Name="users" Size="22" /></span>
                        <div>
                            <h3>@role.Title</h3>
                            <p>@role.Summary</p>
                        </div>
                    </div>

                    <div class="page-hero__meta">
                        <span class="pill">@role.Location</span>
                        <span class="pill">@role.Team</span>
                        <span class="pill">@role.Level</span>
                    </div>

                    <ul class="check-list">
                        @foreach (var requirement in role.Requirements)
                        {
                            <li>
                                <AppIcon Name="check" Size="16" />
                                <span>@requirement</span>
                            </li>
                        }
                    </ul>

                    <div class="plans__toolbar">
                        <a class="btn btn--ghost btn--sm"
                           href="@($"mailto:{CompanyProfile.SalesEmail}?subject={Uri.EscapeDataString($"Application: {role.Title}")}")">
                            Apply by email
                            <AppIcon Name="arrow-right" Size="15" />
                        </a>
                        <span class="text-xs muted">@role.Note</span>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--paper-alt">
    <div class="container">
        <SectionHeading Eyebrow="How we hire"
                       Title="Four steps, two weeks, no unpaid homework sprints"
                       Align="center" />

        <div class="process mt-7">
            <div class="process__step">
                <span class="process__num">01</span>
                <h3>Intro call</h3>
                <p>Thirty minutes with the hiring manager about the work, the team and what you want next.</p>
                <span class="process__time">30 min</span>
            </div>
            <div class="process__step">
                <span class="process__num">02</span>
                <h3>Technical conversation</h3>
                <p>A discussion on systems you have actually built - trade-offs, failures, and what you would do differently.</p>
                <span class="process__time">60 min</span>
            </div>
            <div class="process__step">
                <span class="process__num">03</span>
                <h3>Paid pairing session</h3>
                <p>Two hours pairing on a real Polypus problem. Paid at your day rate, not an unpaid take-home.</p>
                <span class="process__time">2 hours</span>
            </div>
            <div class="process__step">
                <span class="process__num">04</span>
                <h3>Offer</h3>
                <p>Decision and written offer, with the salary band published up front rather than negotiated blind.</p>
                <span class="process__time">48 hours</span>
            </div>
        </div>
    </div>
</section>

