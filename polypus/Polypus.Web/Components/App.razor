<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["home.css"]" />
    <link rel="stylesheet" href="@Assets["Polypus.Web.styles.css"]" />
        @* Reveal-on-scroll is intentionally fail-safe: app.css never hides [data-reveal],
           it only animates it when js/site.js adds .is-visible. Nothing here can blank
           out a section. *@
        <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Progressive enhancement only: sticky header state and reveal-on-scroll.
       Every section renders and is readable with JavaScript disabled. *@
    <script src="@Assets["js/site.js"]"></script>
</body>

</html>
