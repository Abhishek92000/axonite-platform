@*
    AppIcon.razor
    ------------------------------------------------------------------------
    One inline-SVG icon set for the whole site.

    Why this exists
      * There is no third-party icon package in the project, so the site has no
        external font or CDN dependency and nothing extra to keep patched.
      * Every icon is a stroked 24x24 path drawn with `stroke="currentColor"`,
        so an icon takes the colour of whatever it sits inside. That is what
        lets the same "check" icon be teal inside a card and light-teal on a
        dark panel without a second asset.

    How to change something
      * Add an icon by adding a `case "your-name":` branch to the switch below.
      * Use it anywhere with <AppIcon Name="your-name" />.
      * Size sets width/height in pixels, CssClass adds extra classes, and
        StrokeWidth lets large decorative icons look lighter.
*@

<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 24 24"
     width="@Size"
     height="@Size"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth.ToString(System.Globalization.CultureInfo.InvariantCulture)"
     stroke-linecap="round"
     stroke-linejoin="round"
     aria-hidden="true"
     focusable="false"
     class="@CssClass">
    @switch (Name)
    {
        case "scan":
            <path d="M3 7V6a3 3 0 0 1 3-3h1M17 3h1a3 3 0 0 1 3 3v1M21 17v1a3 3 0 0 1-3 3h-1M7 21H6a3 3 0 0 1-3-3v-1" />
            <path d="M3 12h18" />
            <path d="M8 8.5h3M13 8.5h3M8 15.5h3M13 15.5h3" />
            break;

        case "plug":
            <path d="M9 3v6M15 3v6" />
            <path d="M6 9h12v3a6 6 0 0 1-12 0V9Z" />
            <path d="M12 18v3" />
            break;

        case "user-check":
            <path d="M15 19v-1.6a3.4 3.4 0 0 0-3.4-3.4H6.4A3.4 3.4 0 0 0 3 17.4V19" />
            <circle cx="9" cy="7.5" r="3.5" />
            <path d="M16.5 12.5 18 14l3.5-3.5" />
            break;

        case "shield-check":
            <path d="M12 3.5 5 6.3v5.2c0 4 2.9 7.2 7 8.5 4.1-1.3 7-4.5 7-8.5V6.3L12 3.5Z" />
            <path d="M9.2 12.2 11 14l4-4.2" />
            break;

        case "history":
            <path d="M3.6 12a8.4 8.4 0 1 0 2.6-6" />
            <path d="M3.5 4.5v4h4" />
            <path d="M12 8v4.4l3 1.8" />
            break;

        case "chart":
            <path d="M4 20h16" />
            <path d="M7 20v-6M12 20V8M17 20v-9" />
            break;

        case "flow":
            <rect x="3" y="3.5" width="7" height="5" rx="1.6" />
            <rect x="14" y="15.5" width="7" height="5" rx="1.6" />
            <path d="M6.5 8.5V16a2 2 0 0 0 2 2h5.5" />
            break;

        case "lock":
            <rect x="4.5" y="10.5" width="15" height="9.5" rx="2.2" />
            <path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" />
            <path d="M12 14.5v2.5" />
            break;

        case "check":
            <path d="M4.5 12.8 9 17.2l10.5-10.7" />
            break;

        case "check-circle":
            <circle cx="12" cy="12" r="8.6" />
            <path d="M8.4 12.3 11 14.9l4.8-5" />
            break;

        case "arrow-right":
            <path d="M4 12h15" />
            <path d="m13 6 6 6-6 6" />
            break;

        case "arrow-up-right":
            <path d="M7 17 17 7" />
            <path d="M8 7h9v9" />
            break;

        case "chevron-down":
            <path d="m6 9.5 6 6 6-6" />
            break;

        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;

        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;

        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;

        case "search":
            <circle cx="11" cy="11" r="6.6" />
            <path d="m16 16 4 4" />
            break;

        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2.2" />
            <path d="m3.8 6.8 8.2 6 8.2-6" />
            break;

        case "phone":
            <path d="M6.5 3.5h3l1.5 4-2 1.4a11 11 0 0 0 5.1 5.1l1.4-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.7a2 2 0 0 1 2-2.2Z" />
            break;

        case "map-pin":
            <path d="M12 21s6.4-5.6 6.4-10.4A6.4 6.4 0 0 0 5.6 10.6C5.6 15.4 12 21 12 21Z" />
            <circle cx="12" cy="10.4" r="2.4" />
            break;

        case "layers":
            <path d="m12 3 8.5 4.6L12 12.2 3.5 7.6 12 3Z" />
            <path d="m3.5 12.4 8.5 4.6 8.5-4.6" />
            <path d="m3.5 16.8 8.5 4.6 8.5-4.6" />
            break;

        case "tag":
            <path d="M12.6 3.5H19a1.5 1.5 0 0 1 1.5 1.5v6.4a2 2 0 0 1-.6 1.4l-7 7a2 2 0 0 1-2.8 0l-6-6a2 2 0 0 1 0-2.8l7-7a2 2 0 0 1 1.5-.5Z" />
            <circle cx="16.2" cy="7.8" r="1.5" />
            break;

        case "sparkle":
            <path d="M12 3.5 13.9 9 19.5 11 13.9 13 12 18.5 10.1 13 4.5 11 10.1 9 12 3.5Z" />
            <path d="M18.5 16.5 19.3 18.7 21.5 19.5 19.3 20.3 18.5 22.5 17.7 20.3 15.5 19.5 17.7 18.7 18.5 16.5Z" />
            break;

        case "users":
            <path d="M15.5 19.5v-1.7a3.6 3.6 0 0 0-3.6-3.6H6.1a3.6 3.6 0 0 0-3.6 3.6v1.7" />
            <circle cx="9" cy="7.8" r="3.6" />
            <path d="M21.5 19.5v-1.7a3.6 3.6 0 0 0-2.7-3.5M15.8 4.4a3.6 3.6 0 0 1 0 6.9" />
            break;

        case "building":
            <rect x="4" y="3.5" width="10" height="17" rx="1.6" />
            <path d="M14 9.5h5a1.5 1.5 0 0 1 1.5 1.5v9.5" />
            <path d="M7 7h4M7 11h4M7 15h4M17 13h1M17 17h1" />
            break;

        case "globe":
            <circle cx="12" cy="12" r="8.6" />
            <path d="M3.6 12h16.8" />
            <path d="M12 3.4c2.2 2.4 3.3 5.3 3.3 8.6S14.2 18.2 12 20.6C9.8 18.2 8.7 15.3 8.7 12S9.8 5.8 12 3.4Z" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="8.6" />
            <path d="M12 7.4V12l3.2 2" />
            break;

        case "calendar":
            <rect x="3.5" y="5.5" width="17" height="15" rx="2.2" />
            <path d="M3.5 10h17M8 3.5v4M16 3.5v4" />
            break;

        case "headset":
            <path d="M4.5 14v-2a7.5 7.5 0 0 1 15 0v2" />
            <path d="M4.5 13.5h1.8a1.2 1.2 0 0 1 1.2 1.2v3.1a1.2 1.2 0 0 1-1.2 1.2H5.6a1.1 1.1 0 0 1-1.1-1.1v-4.4ZM19.5 13.5h-1.8a1.2 1.2 0 0 0-1.2 1.2v3.1a1.2 1.2 0 0 0 1.2 1.2h.7a1.1 1.1 0 0 0 1.1-1.1v-4.4Z" />
            break;

        case "download":
            <path d="M12 4v10" />
            <path d="m8 10.5 4 4 4-4" />
            <path d="M4.5 17.5v1a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5v-1" />
            break;

        case "linkedin":
            <path d="M5.5 9.5v9M5.5 6.2v.1" />
            <path d="M10.5 18.5v-9M10.5 13.4c0-2.2 1.4-3.6 3.4-3.4 1.9.2 2.9 1.5 2.9 3.7v4.8" />
            break;

        case "github":
            <path d="M9.2 20.5c-3.6 1-4.4-1.7-4.4-1.7-.5-1.2-1.2-1.6-1.2-1.6-1-.7 0-.7 0-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.9-.4-5.3-1.5-5.3-6a4.7 4.7 0 0 1 1.2-3.2 4.4 4.4 0 0 1 .2-3.2s1.2-.4 3.9 1.3a9.5 9.5 0 0 1 5 0c2.7-1.7 3.9-1.3 3.9-1.3a4.4 4.4 0 0 1 .2 3.2 4.7 4.7 0 0 1 1.2 3.2c0 4.5-2.4 5.6-5.3 6 .4.4.8 1.1.8 2.2v3.4" />
            break;

        case "youtube":
            <rect x="3" y="6" width="18" height="12" rx="3.2" />
            <path d="m11 9.5 4 2.5-4 2.5v-5Z" />
            break;

        case "star":
            <path d="m12 4 2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8L12 4Z" />
            break;

        case "alert":
            <path d="M12 4.5 21 19.5H3L12 4.5Z" />
            <path d="M12 10v4M12 16.6v.1" />
            break;

        case "api":
            <circle cx="6" cy="12" r="2.6" />
            <circle cx="18" cy="6" r="2.6" />
            <circle cx="18" cy="18" r="2.6" />
            <path d="M8.4 10.7 15.6 7.2M8.4 13.3l7.2 3.5" />
            break;

        case "bowtie":
            <path d="M4 6.5 11 12 4 17.5V6.5ZM20 6.5 13 12l7 5.5V6.5Z" fill="currentColor" stroke="none" />
            break;

        case "database":
            <ellipse cx="12" cy="6" rx="7.5" ry="3" />
            <path d="M4.5 6v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6" />
            <path d="M4.5 12v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6" />
            break;

        default:
            <circle cx="12" cy="12" r="8.6" />
            break;
    }
</svg>

@code {
    /// <summary>Key of the icon to draw. See the switch above for the full list.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "check";

    /// <summary>Width and height in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    /// <summary>Extra CSS classes applied to the svg element.</summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>Stroke weight. Lower this for large decorative icons.</summary>
    [Parameter]
    public double StrokeWidth { get; set; } = 1.7;
}
